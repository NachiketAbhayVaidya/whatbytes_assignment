rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profile: written once at sign-up, readable only by its owner.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'usernameLower', 'createdAt'])
        && request.resource.data.username is string
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        // The matching username claim must be created in the same batch.
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Tasks: private to the owner.
    match /users/{uid}/tasks/{taskId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Username claims. Document id = lowercase username, so ids are unique.
    // Anyone may check one name (get) but nobody can list them.
    match /usernames/{name} {
      allow get: if true;
      allow create: if request.auth != null
        && name.matches('[a-z0-9_]{3,20}')
        && request.resource.data.keys().hasOnly(['uid', 'username'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.lower() == name;
      allow update, delete: if false; // names can't be stolen or changed
    }
  }
}
